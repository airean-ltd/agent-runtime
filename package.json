{
  "name": "@eankhbayar/agent-runtime",
  "version": "0.15.0",
  "description": "Runtimes for sandboxed coding agents: the run-event contract, executeRun and the store interfaces, pipeline run events, a shared model client, a job harness and Cloud Run dispatch, Docker and Cloud Run sandbox providers, the egress gateway with project data commands and the agent-data CLI, and the in-sandbox runners of the pi runtime and the experimental pi-durable one.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": "github:airean-ltd/agent-runtime",
  "files": [
    "dist",
    "gateway",
    "infra"
  ],
  "bin": {
    "agent-data": "dist/data/cli.js"
  },
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./providers/docker": {
      "types": "./dist/providers/docker/index.d.ts",
      "default": "./dist/providers/docker/index.js"
    },
    "./providers/cloud-run": {
      "types": "./dist/providers/cloud-run/index.d.ts",
      "default": "./dist/providers/cloud-run/index.js"
    },
    "./pi/runner": {
      "types": "./dist/pi/runner/index.d.ts",
      "default": "./dist/pi/runner/index.js"
    },
    "./pi-durable/runner": {
      "types": "./dist/pi-durable/runner/index.d.ts",
      "default": "./dist/pi-durable/runner/index.js"
    },
    "./dispatch/cloud-run": {
      "types": "./dist/dispatch/cloud-run/index.d.ts",
      "default": "./dist/dispatch/cloud-run/index.js"
    },
    "./job": {
      "types": "./dist/job/index.d.ts",
      "default": "./dist/job/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contract.json && tsc -p tsconfig.dispatch.json && tsc -p tsconfig.models.json && tsc -p tsconfig.data.json",
    "test": "vitest run",
    "ready": "pnpm typecheck && pnpm test && pnpm build",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <2",
    "@earendil-works/pi-durable": "1.5.1",
    "@earendil-works/pi-schema": "1.5.1",
    "typebox": "^1.3.30"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@earendil-works/chord": "1.5.1",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@earendil-works/pi-durable": "1.5.1",
    "@earendil-works/pi-schema": "1.5.1",
    "@types/node": "^24",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
